# OpenAI Organization Admin API key. MOCK_MODE=trueの場合は空のままで起動できます。
OPENAI_ADMIN_KEY=

# 画面タイトルの横に表示する任意の集計対象名（例: Example Organization）。
DASHBOARD_SUBTITLE=

# 実APIを使わず、画面確認用のデモデータを生成します。
MOCK_MODE=true

# 0.0.0.0でLAN内の全インターフェース、特定IPで接続元ネットワークを限定できます。
DASHBOARD_BIND_ADDRESS=0.0.0.0
DASHBOARD_PORT=8080

TZ=Asia/Tokyo
SYNC_INTERVAL_MINUTES=60
INITIAL_HISTORY_DAYS=90
SYNC_LOOKBACK_DAYS=3

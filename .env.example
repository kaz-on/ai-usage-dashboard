# OpenAI Organization Admin API key. Usage API Scope と Organization Administration の Read 権限が必要です。
# MOCK_MODE=trueの場合は空のままで起動できます。
OPENAI_ADMIN_KEY=

# 画面タイトルの横に表示する任意の集計対象名（例: Example Organization）。
DASHBOARD_SUBTITLE=

# 実APIを使わず、画面確認用のデモデータを生成します。
MOCK_MODE=true

# 初期値はこのホストからのみアクセスできます。LANで使う場合はホストのLAN側IPを指定してください。
# 待ち受けIPの指定は接続元の制限ではありません。接続元はファイアウォール等で制限してください。
DASHBOARD_BIND_ADDRESS=127.0.0.1
DASHBOARD_PORT=8080

TZ=Asia/Tokyo
SYNC_INTERVAL_MINUTES=60
INITIAL_HISTORY_DAYS=90
SYNC_LOOKBACK_DAYS=3
